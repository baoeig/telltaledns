# TelltaleDNS: install a version the cluster asked for (REQ: OPS-014, ADR-182). Started by
# telltale-update.path; installed by deploy/systemd/install.sh.
#
# It runs as root because it replaces the binary and restarts the service, which the sandboxed
# telltale service can't (ADR-038, ADR-046). It trusts nothing in the request: it reads only a
# small regular file owned by the telltale user, removes it, acts only on a release or edge build
# newer than the one installed, and installs only a binary carrying the release signature. The
# outcome goes to /var/lib/telltale-update/result.json, which the node reads.
[Unit]
Description=TelltaleDNS: install a version the cluster asked for
Documentation=https://github.com/paimonsoror/telltaledns/blob/main/docs/running.md#upgrading-from-the-cluster
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/telltale self-update --request /var/lib/telltale/update-request.json --restart
Environment=TELLTALE_INSTALL=native
TimeoutStartSec=600
StateDirectory=telltale-update
StateDirectoryMode=0755
UMask=0022

# Writes only the binary's directory, the request's directory (to remove it), and its own state.
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /var/lib/telltale
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
